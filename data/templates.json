      "options": [
        {
          "id": "ec2-rds",
          "name": "EC2 + RDS",
          "summary": "가상 서버(EC2)에 앱을 올리고, DB는 관리형 RDS 사용",
          "pros": [
            "가장 일반적인 구성이라 자료가 많음",
            "DB 백업·패치를 AWS가 관리",
            "서버 사양을 자유롭게 바꿀 수 있음"
          ],
          "cons": [
            "보안 그룹, VPC 등 알아야 할 게 많음",
            "서버 OS 업데이트는 직접 해야 함",
            "숨은 비용(IPv4, 전송량)을 놓치기 쉬움"
          ],
          "resources": [
            {
              "type": "ec2",
              "instance": "{{preset.instance}}",
              "count": "{{preset.count}}"
            },
            {
              "type": "ebs",
              "sizeGb": "{{preset.ebsGb}}",
              "count": "{{preset.count}}"
            },
            {
              "type": "publicIpv4",
              "count": "{{preset.count}}",
              "attachedTo": "EC2"
            },
            {
              "type": "alb",
              "count": "{{preset.albCount}}",
              "lcu": "{{preset.albLcu}}"
            },
            {
              "type": "publicIpv4",
              "count": "{{preset.albCount}}",
              "attachedTo": "ALB",
              "multiplier": 2
            },
            {
              "type": "rds",
              "instance": "{{preset.dbInstance}}",
              "storageGb": "{{preset.dbStorageGb}}"
            },
            {
              "type": "dataTransferOut",
              "gb": "{{preset.egressGb}}"
            }
          ]
        },
        {
          "id": "lightsail",
          "name": "Lightsail",
          "summary": "서버·디스크·IP·전송량이 묶인 월 정액 서버 1대에 앱과 DB를 같이 설치",
          "pros": [
            "월 고정 요금이라 예측이 쉬움",
            "IPv4·디스크·전송량이 요금에 포함",
            "콘솔이 단순해서 입문용으로 좋음"
          ],
          "cons": [
            "DB를 직접 설치·백업해야 함 (관리형 DB는 월 $15부터 추가)",
            "서버 1대라 장애 시 서비스 중단",
            "규모가 커지면 EC2로 옮겨야 할 수 있음"
          ],
          "resources": [
            {
              "type": "lightsail",
              "bundle": "{{preset.lightsailBundle}}"
            }
          ]
        },
        {
          "id": "fargate-rds",
          "name": "ECS Fargate + RDS",
          "summary": "서버 없이 도커 컨테이너만 실행(Fargate), DB는 RDS",
          "pros": [
            "서버(OS) 관리가 필요 없음",
            "컨테이너 개수로 쉽게 확장",
            "배포 자동화와 궁합이 좋음"
          ],
          "cons": [
            "도커 이미지 빌드·ECR 사용법을 알아야 함",
            "같은 사양이면 EC2보다 비쌈",
            "네트워크 설정(서브넷, NAT)이 헷갈리기 쉬움"
          ],
          "resources": [
            {
              "type": "fargate",
              "vcpu": "{{preset.fargateVcpu}}",
              "memoryGb": "{{preset.fargateMemoryGb}}",
              "count": "{{preset.fargateCount}}"
            },
            {
              "type": "publicIpv4",
              "count": "{{preset.fargateCount}}",
              "attachedTo": "Fargate 태스크"
            },
            {
              "type": "alb",
              "count": "{{preset.albCount}}",
              "lcu": "{{preset.albLcu}}"
            },
            {
              "type": "publicIpv4",
              "count": "{{preset.albCount}}",
              "attachedTo": "ALB",
              "multiplier": 2
            },
            {
              "type": "rds",
              "instance": "{{preset.dbInstance}}",
              "storageGb": "{{preset.dbStorageGb}}"
            },
            {
              "type": "dataTransferOut",
              "gb": "{{preset.egressGb}}"
            }
          ]
        }
