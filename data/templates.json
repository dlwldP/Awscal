          "description": "일 방문자 1만 명 정도",
          "values": {
            "storageGb": 5,
            "requests": 10000000,
            "s3GetRequests": 1000000,
            "putRequests": 5000,
            "egressGb": 200,
            "buildMinutes": 150
          },
          "assumptions": [
            "사이트 파일 5GB",
            "월 요청 1,000만 건",
            "월 전송량 200GB",
            "배포 시 파일 업로드 월 5천 건",
            "Amplify 빌드 월 150분"
          ]
        }
      ],
      "options": [
        {
          "id": "s3-cloudfront",
          "name": "S3 + CloudFront",
          "summary": "파일은 S3에 두고, 전 세계 CDN(CloudFront)으로 빠르게 전달",
          "pros": [
            "쓴 만큼만 내서 작은 사이트는 거의 0원",
            "서버 관리가 전혀 없음",
            "CDN 덕분에 빠르고 트래픽 급증에도 안정적"
          ],
          "cons": [
            "처음 설정(버킷 정책, OAC, 인증서)이 조금 번거로움",
            "배포 자동화는 직접 구성해야 함 (GitHub Actions 등)"
          ],
          "resources": [
            {
              "type": "s3",
              "storageGb": "{{preset.storageGb}}",
              "putRequests": "{{preset.putRequests}}",
              "getRequests": "{{preset.s3GetRequests}}"
            },
            {
              "type": "cloudfront",
              "gb": "{{preset.egressGb}}",
              "requests": "{{preset.requests}}"
            }
          ]
        },
        {
          "id": "amplify",
          "name": "Amplify Hosting",
          "summary": "GitHub 레포를 연결하면 빌드·배포·CDN까지 알아서",
          "pros": [
            "Git 푸시만 하면 자동 배포",
            "HTTPS, 도메인 연결이 클릭 몇 번",
            "설정이 가장 쉬움"
          ],
          "cons": [
            "전송량 단가가 CloudFront 직접 사용보다 비쌈",
            "빌드 시간만큼 요금이 붙음"
          ],
          "resources": [
            {
              "type": "amplify",
              "buildMinutes": "{{preset.buildMinutes}}",
              "storageGb": "{{preset.storageGb}}",
              "servedGb": "{{preset.egressGb}}"
            }
          ]
        }
      ]
    },
